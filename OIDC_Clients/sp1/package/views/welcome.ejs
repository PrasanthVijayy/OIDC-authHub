<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SP-1 | Welcome</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        text-align: center;
        margin: 50px;
        background-color: #f9f9f9;
        color: #333;
      }
      h1 {
        color: #007bff;
        margin-bottom: 20px;
      }
      p {
        font-size: 18px;
        color: #555;
        margin-bottom: 30px;
      }
      .btn {
        background-color: #007bff;
        color: white;
        padding: 10px 20px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-size: 16px;
      }
      .btn:hover {
        background-color: #0056b3;
      }
      .footer {
        margin-top: 20px;
        font-size: 14px;
        color: #777;
      }
    </style>
    
  </head>
  <form action = "/logout" method = "POST">
    <h1>Welcome, <%= username %></h1>
    <h2>Logged in as: <%= email %></h2>
    <p>You've successfully logged in using OIDC with <b>SP-1.</b></p>

    <button class="btn">Logout</button>
</form>
    <div class="footer"></div>
    
<script>
  document.addEventListener("DOMContentLoaded", function () {
    // Replace the history so that the back button doesn't navigate back
    window.history.replaceState(null, null, "/welcome");

    // Listen for back navigation and force reload to /welcome
    window.onpopstate = function () {
      history.pushState(null, null, "/welcome");
      location.replace("/welcome"); // Force redirect without adding new history entry
    };

    // Immediately clear forward navigation history
    setTimeout(() => {
      window.history.pushState(null, null, "/welcome");
    }, 0);
  });
</script>



  </body>
</html>
